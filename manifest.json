{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "1.0.15",
  "description": "__MSG_extDescription__",
  "chrome_url_overrides": {
    "newtab": "newtab-bootstrap.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "topSites",
    "bookmarks",
    "favicon",
    "alarms",
    "activeTab",
    "tabs",
    "cookies",
    "declarativeNetRequest",
    "identity",
    "scripting",
    "notifications",
    "downloads",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://*.jianguoyun.com/*",
    "https://dav.jianguoyun.com/*",
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "https://api.todoist.com/*",
    "https://www.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://api.github.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://aihot.virxact.com/*",
    "https://aihot.news/*",
    "https://monster-siren.hypergryph.com/*",
    "https://*.hycdn.cn/*",
    "http://127.0.0.1/*",
    "https://r.jina.ai/*",
    "https://itunes.apple.com/*",
    "https://cn.bing.com/*",
    "https://*.bing.com/*",
    "https://image.baidu.com/*",
    "https://*.baidu.com/*",
    "https://*.music.126.net/*",
    "https://*.126.net/*",
    "https://music.163.com/*",
    "https://*.music.163.com/*",
    "https://*.163.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' https://player.bilibili.com blob:; img-src 'self' https: http: data: blob:;",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src blob:; frame-src blob:;"
  },
  "options_page": "options.html",
  "sandbox": {
    "pages": [
      "wallpaper-sandbox.html"
    ]
  },
  "action": {
    "default_title": "打开 tab-project 侧边栏",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "commands": {
    "open-side-panel": {
      "suggested_key": { "default": "Alt+W", "mac": "Alt+W" },
      "description": "展开或收起覆盖式侧栏（不挤压网页）"
    },
    "focus-newtab": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "立即回到 tab-project-next 新标签页"
    }
  },
  "background": {
    "service_worker": "generated/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html"],
      "matches": ["https://*/*", "http://*/*"]
    },
    {
      "resources": [
        "favicon.ico",
        "assets/icon-16.png",
        "assets/icon-32.png",
        "assets/icon-48.png",
        "assets/icon-128.png",
        "assets/nav-home.svg"
      ],
      "matches": [
        "https://*/*",
        "http://*/*"
      ]
    }
  ]
}
